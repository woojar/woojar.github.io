{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{ range .Data.Pages }}
  <url>
    <loc>{{ .Permalink }}</loc>
    <lastmod>{{ .Lastmod.Format "2006-01-02" }}</lastmod>
    <changefreq>{{ if .IsPage }}weekly{{ else }}daily{{ end }}</changefreq>
    <priority>{{ if .IsPage }}0.8{{ else }}0.7{{ end }}</priority>
  </url>
  {{ end }}
</urlset>